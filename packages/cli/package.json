{
  "name": "@plainrouter/cli",
  "version": "0.3.1",
  "description": "Command-line interface for the PlainRouter API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wudaku/plainrouter-sdk.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "bin": {
    "plainrouter": "./bin/plainrouter.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@plainrouter/sdk": "0.3.1",
    "commander": "15.0.0"
  }
}
