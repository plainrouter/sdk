# frozen_string_literal: true

require "rake/testtask"
require "bundler/gem_helper"
require "rubygems/package"

Rake::TestTask.new do |task|
  task.libs << "lib" << "test"
  task.pattern = "test/**/*_test.rb"
  task.warning = false
end

Bundler::GemHelper.install_tasks
Bundler::GemHelper.tag_prefix = "ruby-"

desc "Verify the built gem contains the curated and generated clients"
task verify_package: :build do
  gem_file = Dir["pkg/plainrouter-sdk-*.gem"].fetch(0)
  gem_specification = Gem::Package.new(gem_file).spec
  expected = %w[
    lib/plainrouter.rb
    lib/plainrouter/client.rb
    lib/plainrouter/openapi.rb
    lib/plainrouter/openapi/api/event_api.rb
    lib/plainrouter/openapi/api/operations_api.rb
    lib/plainrouter/openapi/api/sandbox_api.rb
    lib/plainrouter/version.rb
  ]

  files = gem_specification.files
  missing = expected - files
  raise "gem is missing: #{missing.join(', ')}" unless missing.empty?
  raise "gem homepage must identify https://plainrouter.com" unless gem_specification.homepage == "https://plainrouter.com"
  unless gem_specification.metadata["homepage_uri"] == "https://plainrouter.com"
    raise "gem homepage_uri must identify https://plainrouter.com"
  end

  puts "Verified #{File.basename(gem_file)} (#{files.length} files)"
end

task default: :test
