{
  "name": "@plainrouter/sdk",
  "version": "0.10.0",
  "description": "Generated TypeScript client and Zod schemas for the Plainrouter API, supporting Meta conversion tracking and governed ad changes.",
  "homepage": "https://plainrouter.com",
  "keywords": ["plainrouter", "meta-ads", "facebook-ads", "conversions-api", "mcp", "sdk", "openapi", "typescript"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plainrouter/sdk.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node ../../scripts/generate-operation-exports.mjs",
    "build": "tsc --project tsconfig.build.json",
    "pretest": "node ../../scripts/generate-operation-exports.mjs",
    "test": "vitest run",
    "pretypecheck": "node ../../scripts/generate-operation-exports.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
