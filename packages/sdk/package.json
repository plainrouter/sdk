{
  "name": "@plainrouter/sdk",
  "version": "0.5.0",
  "description": "Generated TypeScript client and Zod schemas for the PlainRouter API.",
  "homepage": "https://plainrouter.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plainrouter/sdk.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
