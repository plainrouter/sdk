{
  "name": "plainrouter-sdk-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sdk",
    "packages/cli"
  ],
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "generate": "openapi-ts",
    "smoke:cli": "node scripts/cli-smoke.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "spec:drift": "node scripts/check-spec-drift.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:spec": "node scripts/verify-spec.mjs"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
